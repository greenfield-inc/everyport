{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Everyport",
  "identifier": "dev.everyport.desktop",
  "build": {
    "beforeDevCommand": "node scripts/sidecar.mjs && pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/sidecar.mjs --release && pnpm installer-art && pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "Everyport",
        "width": 400,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright (c) 2026 Dcouple, Inc.",
    "publisher": "Dcouple, Inc.",
    "targets": "all",
    "externalBin": ["binaries/everyport-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "background": "installer/dmg-background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "installer/installer.ico",
        "uninstallerIcon": "installer/installer.ico",
        "installerHooks": "windows/installer.nsh"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp",
        "language": { "en-US": { "localePath": "windows/en-US.wxl" } }
      }
    }
  }
}
