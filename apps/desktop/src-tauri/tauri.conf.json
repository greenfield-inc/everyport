{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Port Process Manager",
  "version": "0.1.0",
  "identifier": "to.greenfield.portprocessmanager",
  "build": {
    "beforeDevCommand": "node scripts/sidecar.mjs && pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/sidecar.mjs --release && pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "Port Process Manager",
        "width": 400,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/ppm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
